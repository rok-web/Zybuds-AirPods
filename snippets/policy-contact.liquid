      <div class="contact-card-value">
        <a href="mailto:Ganimedia1@gmail.com" style="color:var(--white); text-decoration:none;">Ganimedia1@gmail.com</a>
      </div>
      <div class="contact-card-sub">For general support, warranty claims, and order inquiries.</div>
    </div>

    <!-- WhatsApp Support -->
    <div class="contact-card">
      <div class="contact-card-title">💬 WhatsApp Support</div>
      <div class="contact-card-value">9704252065</div>
      <div class="contact-card-sub" style="color: var(--accent);">⚠️ Available only on WhatsApp. Note: strictly no voice/video calls.</div>
      <a href="https://wa.me/919704252065" target="_blank" class="wa-btn">
