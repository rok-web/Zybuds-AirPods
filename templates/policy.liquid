{% comment %}
  templates/policy.liquid
  Premium, custom-designed template to override Shopify's native policies pages.
  Renders custom Zybuds content automatically without requiring page creation.
{% endcomment %}

<style>
  .policy-container {
    max-width: 840px;
    margin: 40px auto;
    padding: 50px 40px;
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
  }
  .policy-header {
    text-align: center;
    margin-bottom: 40px;
  }
  .policy-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 900;
    color: var(--white);
    margin-bottom: 12px;
  }
  .policy-meta {
    font-size: 13px;
    color: var(--accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 500;
  }
  .policy-notice {
    padding: 16px 20px;
    background: rgba(232, 201, 122, 0.03);
    border-left: 3px solid var(--accent);
    border-radius: 6px;
    margin-bottom: 35px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--ink2);
    text-align: center;
  }
  .policy-content h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(18px, 2.2vw, 22px);
    font-weight: 700;
    color: var(--white);
    margin-top: 40px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 8px;
  }
  .policy-content h3 {
    font-size: 16px;
    font-weight: 600;
    color: var(--accent);
    margin-top: 24px;
    margin-bottom: 12px;
  }
  .policy-content p {
    font-size: 14.5px;
    color: var(--ink2);
    line-height: 1.8;
    margin-bottom: 20px;
  }
  .policy-content ul {
    margin-bottom: 24px;
    padding-left: 20px;
  }
  .policy-content li {
    font-size: 14px;
    color: var(--ink2);
    line-height: 1.7;
    margin-bottom: 8px;
    list-style-type: square;
  }
  .policy-table-wrapper {
    overflow-x: auto;
    margin: 24px 0;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .policy-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
    text-align: left;
    min-width: 600px;
  }
  .policy-table th, .policy-table td {
    padding: 14px 18px;
    vertical-align: top;
    border-bottom: 1px solid var(--border);
  }
  .policy-table th {
    background: var(--bg4);
    color: var(--white);
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .policy-table td {
    color: var(--ink2);
    background: var(--bg2);
    line-height: 1.6;
  }
  .policy-table tr:last-child td {
    border-bottom: none;
  }
  .shipping-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin: 24px 0;
  }
  .shipping-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .shipping-card:hover {
    transform: translateY(-2px);
    border-color: var(--border2);
  }
  .shipping-card-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--white);
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .shipping-card-value {
    font-size: 20px;
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 6px;
  }
  .shipping-card-desc {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.5;
  }
  .support-box {
    padding: 18px 22px;
    background: rgba(76, 175, 110, 0.03);
    border-left: 3px solid var(--green);
    border-radius: 6px;
    margin: 24px 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink2);
  }
  .support-box strong {
    color: var(--white);
  }
  .policy-contact-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
    margin-top: 30px;
  }
  .policy-contact-card p {
    margin-bottom: 12px !important;
  }
  .policy-contact-card p:last-child {
    margin-bottom: 0 !important;
  }
  .policy-contact-card strong {
    color: var(--white);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    margin-top: 30px;
  }
  .contact-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .contact-card:hover {
    transform: translateY(-2px);
    border-color: var(--border2);
  }
  .contact-card-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .contact-card-value {
    font-size: 16px;
    color: var(--white);
    line-height: 1.6;
    font-weight: 500;
  }
  .contact-card-sub {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.5;
  }
  .wa-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: var(--green);
    color: var(--white) !important;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    padding: 12px 20px;
    border-radius: 30px;
    margin-top: 10px;
    align-self: flex-start;
    transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .wa-btn:hover {
    background: #3e965b;
    transform: scale(1.03);
    box-shadow: 0 4px 15px rgba(76, 175, 110, 0.3);
  }
  @media (max-width: 768px) {
    .policy-container {
      margin: 20px 12px;
      padding: 30px 20px;
    }
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="policy-container">
