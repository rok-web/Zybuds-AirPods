{% comment %}
  templates/policy.liquid
  Master Router for Native Shopify Policies.
  Upgraded by Senior CSS Developer to support high-fidelity, vibrant & colorful styles dynamically.
{% endcomment %}

{%- assign handle = '' -%}
{%- if request.path contains 'privacy-policy' or policy.title contains 'Privacy' -%}
  {%- assign handle = 'privacy-policy' -%}
{%- elsif request.path contains 'terms-of-service' or policy.title contains 'Terms' -%}
  {%- assign handle = 'terms-of-service' -%}
{%- elsif request.path contains 'shipping-policy' or policy.title contains 'Shipping' -%}
  {%- assign handle = 'shipping-policy' -%}
{%- elsif request.path contains 'contact' or policy.title contains 'Contact' -%}
  {%- assign handle = 'contact' -%}
{%- endif -%}

{%- if handle == 'privacy-policy' -%}
  {%- render 'policy-privacy' -%}
{%- elsif handle == 'terms-of-service' -%}
  {%- render 'policy-terms' -%}
{%- elsif handle == 'shipping-policy' -%}
  {%- render 'policy-shipping' -%}
{%- elsif handle == 'contact' -%}
  {%- render 'policy-contact' -%}
{%- else -%}
  <style>
    .policy-container {
      max-width: 860px;
      margin: 50px auto;
      padding: 60px 45px;
      background: #0b0b14; /* Rich deep indigo-black base */
      border: 1px solid rgba(255, 255, 255, 0.07);
      border-radius: var(--radius-lg);
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.7), 0 0 80px rgba(255, 179, 0, 0.03);
      position: relative;
      overflow: hidden;
    }
    
    /* Tri-color glowing trust accent line */
    .policy-container::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 4px;
      background: linear-gradient(90deg, #ff9933 0%, #ffcc00 50%, #4caf6e 100%);
      box-shadow: 0 2px 10px rgba(255, 179, 0, 0.3);
    }

    .policy-header {
      text-align: center;
      margin-bottom: 45px;
    }
    
    .policy-title {
      font-family: 'Playfair Display', serif;
      font-size: clamp(32px, 5vw, 46px);
      font-weight: 900;
      background: linear-gradient(135deg, #ffe082 0%, #ffb300 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 12px;
      letter-spacing: -0.01em;
      text-shadow: 0 0 30px rgba(255, 179, 0, 0.15);
    }
    
    .policy-meta {
      font-size: 13px;
      color: #ffb74d;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    /* Trust Badges Widget (High-Contrast & Colorful) */
    .trust-badge-container {
      display: flex;
      justify-content: center;
      gap: 14px;
      margin: 25px 0 35px 0;
      flex-wrap: wrap;
    }
    
    .trust-badge {
      padding: 9px 18px;
      border-radius: 30px;
      font-size: 12px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
      transition: transform 0.2s ease;
    }

    .trust-badge:hover {
      transform: translateY(-1px);
    }
    
    .trust-badge-secured {
      background: rgba(76, 175, 110, 0.08) !important;
      border: 1px solid rgba(76, 175, 110, 0.35) !important;
      color: #81c784 !important;
    }
    
    .trust-badge-verified {
      background: rgba(232, 201, 122, 0.08) !important;
      border: 1px solid rgba(232, 201, 122, 0.35) !important;
      color: #ffd54f !important;
    }
    
    .trust-badge-compliant {
      background: rgba(255, 153, 51, 0.08) !important;
      border: 1px solid rgba(255, 153, 51, 0.35) !important;
      color: #ffb74d !important;
    }
    
    .trust-icon {
      font-size: 13px;
    }

    /* Confidence Shield Box (Rich Green-Gold Gradient) */
    .confidence-shield-box {
      display: flex;
      align-items: flex-start;
      gap: 18px;
      padding: 24px 28px;
      background: linear-gradient(135deg, rgba(76, 175, 110, 0.1) 0%, rgba(255, 179, 0, 0.05) 100%);
      border: 1px solid rgba(255, 179, 0, 0.25);
      border-left: 5px solid #4caf6e;
      border-radius: var(--radius);
      margin-bottom: 40px;
      box-shadow: 0 10px 30px rgba(76, 175, 110, 0.08);
    }
    
    .confidence-shield-icon {
      font-size: 32px;
      line-height: 1;
    }
    
    .confidence-shield-text {
      font-size: 13.5px;
      line-height: 1.6;
      color: var(--ink2);
    }
    
    .confidence-shield-text strong {
      color: #ffffff;
      font-size: 15.5px;
      display: block;
      margin-bottom: 4px;
    }

    /* Colorful Legal Card Sections */
    .policy-section-card {
      background: rgba(255, 255, 255, 0.015);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: var(--radius);
      padding: 35px;
      margin-bottom: 30px;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .policy-section-card:hover {
      border-color: rgba(255, 179, 0, 0.2);
      box-shadow: 0 10px 35px rgba(255, 179, 0, 0.05);
    }

    .policy-content {
      color: var(--ink2);
      line-height: 1.8;
      font-size: 14.5px;
    }

    .policy-content h2, .policy-content h1 {
      font-family: 'Playfair Display', serif;
      font-size: clamp(20px, 2.5vw, 24px);
      font-weight: 700;
      color: #ffb300; /* Beautiful deep warm gold */
      margin-top: 24px;
      margin-bottom: 18px;
    }

    .policy-content hr {
      border: 0;
      height: 1px;
      background: rgba(255, 255, 255, 0.08);
      margin: 24px 0;
    }

    .policy-content ul {
      margin-bottom: 20px;
      padding-left: 20px;
    }
    
    .policy-content li {
      font-size: 14px;
      color: var(--ink2);
      line-height: 1.7;
      margin-bottom: 8px;
      list-style-type: square;
    }

    @media (max-width: 768px) {
      .policy-container {
        margin: 20px 12px;
        padding: 35px 22px;
      }
      .policy-section-card {
        padding: 20px;
      }
    }
  </style>

  <div class="policy-container">
    <div class="policy-header">
      <h1 class="policy-title">{{ policy.title }}</h1>
      <div class="policy-meta">Store Policy Information</div>
    </div>

    <!-- Trust Badges Widget -->
    <div class="trust-badge-container">
      <div class="trust-badge trust-badge-secured"><span class="trust-icon">🔒</span> Secured SSL Connection</div>
      <div class="trust-badge trust-badge-verified"><span class="trust-icon">🛡️</span> Verified Local Merchant</div>
      <div class="trust-badge trust-badge-compliant"><span class="trust-icon">🇮🇳</span> 100% Secure Shopping</div>
    </div>

    <!-- Confidence Shield Box -->
    <div class="confidence-shield-box">
      <div class="confidence-shield-icon">🛡️</div>
      <div class="confidence-shield-text">
        <strong>Official Store Policy</strong>
        This is the official policy of Zybuds. If you have any questions or require support regarding your order, please do not hesitate to contact our customer support desk.
      </div>
    </div>

    <div class="policy-content">
      <div class="policy-section-card">
        {{ policy.body }}
      </div>
    </div>
  </div>
{%- endif -%}
