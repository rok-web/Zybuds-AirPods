{% comment %} Collection page {% endcomment %}

<div class="collection-hero" style="max-width:1440px;margin:0 auto;padding:40px 5% 0 5%;display:flex;align-items:center;gap:40px;">
  {% if collection.image %}
    <img src="{{ collection.image | image_url: width: 400 }}" alt="{{ collection.title }}" style="width:320px;height:320px;object-fit:cover;border-radius:var(--radius-lg);box-shadow:0 4px 32px rgba(0,0,0,0.10);background:var(--bg4);">
  {% else %}
    <div style="width:320px;height:320px;background:var(--bg4);border-radius:var(--radius-lg);display:flex;align-items:center;justify-content:center;font-size:80px;">🎧</div>
  {% endif %}
  <div>
    <div class="editorial-label" style="font-size:16px;color:var(--accent);font-weight:700;margin-bottom:8px;">{{ collection.title }}</div>
    <h1 class="p2-title" style="margin-bottom:16px;font-size:2.5rem;line-height:1.1;">{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <div class="p2-tagline" style="margin-bottom:24px;font-size:1.2rem;color:var(--muted);">{{ collection.description }}</div>
    {% else %}
      <div class="p2-tagline" style="margin-bottom:24px;font-size:1.2rem;color:var(--muted);">Browse our full range. Same-day delivery across Hyderabad.</div>
    {% endif %}
  </div>
</div>

<div style="max-width:1440px;margin:0 auto;padding:0 5% 60px 5%;">
  {% if collection.products.size > 0 %}
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:32px;">
      {% for product in collection.products %}
        <a href="{{ product.url }}" style="text-decoration:none;">
          <div style="background:var(--bg3);border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;transition:all 0.25s;box-shadow:0 2px 12px rgba(0,0,0,0.04);display:flex;flex-direction:column;height:100%;">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.featured_image.alt | escape }}"
                style="width:100%;height:240px;object-fit:contain;background:var(--bg4);padding:24px 24px 0 24px;">
            {% else %}
              <div style="height:240px;background:var(--bg4);display:flex;align-items:center;justify-content:center;font-size:48px;">🎧</div>
            {% endif %}
            <div style="padding:24px 24px 20px 24px;flex:1;display:flex;flex-direction:column;justify-content:space-between;">
              <div style="font-size:18px;font-weight:700;color:var(--ink);margin-bottom:10px;line-height:1.3;">{{ product.title }}</div>
              {%- if product.handle == 'zybuds-airpods' -%}
                {%- assign current_price = 140000 -%}
                {%- assign current_compare_at = 349900 -%}
              {%- else -%}
                {%- assign current_price = product.price -%}
                {%- assign current_compare_at = product.compare_at_price -%}
              {%- endif -%}
              <div style="display:flex;align-items:center;gap:12px;margin-bottom:10px;">
                <span style="font-family:'Playfair Display',serif;font-size:22px;font-weight:900;color:var(--white);">{{ current_price | money }}</span>
                {% if current_compare_at > current_price %}
                  <span style="font-size:14px;color:var(--muted);text-decoration:line-through;">{{ current_compare_at | money }}</span>
                {% endif %}
              </div>
              <button style="margin-top:auto;padding:10px 0;width:100%;background:var(--accent);color:var(--bg);font-weight:700;border:none;border-radius:var(--radius-md);font-size:1rem;cursor:pointer;transition:background 0.2s;">View Product</button>
            </div>
          </div>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <p style="color:var(--muted);text-align:center;font-size:1.2rem;margin-top:40px;">No products found in this collection.</p>
  {% endif %}
</div>
