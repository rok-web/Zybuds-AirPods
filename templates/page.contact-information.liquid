{% comment %}
  templates/page.contact-information.liquid
  Premium, custom-designed page template for Zybuds Contact Information.
{% endcomment %}

<style>
  .policy-container {
    max-width: 840px;
    margin: 40px auto;
    padding: 50px 40px;
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
  }
  .policy-header {
    text-align: center;
    margin-bottom: 40px;
  }
  .policy-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 900;
    color: var(--white);
    margin-bottom: 12px;
  }
  .policy-meta {
    font-size: 13px;
    color: var(--accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 500;
  }
  .policy-notice {
    padding: 16px 20px;
    background: rgba(232, 201, 122, 0.03);
    border-left: 3px solid var(--accent);
    border-radius: 6px;
    margin-bottom: 35px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--ink2);
    text-align: center;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    margin-top: 30px;
  }
  .contact-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .contact-card:hover {
    transform: translateY(-2px);
    border-color: var(--border2);
  }
  .contact-card-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .contact-card-value {
    font-size: 16px;
    color: var(--white);
    line-height: 1.6;
    font-weight: 500;
  }
  .contact-card-sub {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.5;
  }
  .wa-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: var(--green);
    color: var(--white) !important;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    padding: 12px 20px;
    border-radius: 30px;
    margin-top: 10px;
    align-self: flex-start;
    transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .wa-btn:hover {
    background: #3e965b;
    transform: scale(1.03);
    box-shadow: 0 4px 15px rgba(76, 175, 110, 0.3);
  }
  @media (max-width: 768px) {
    .policy-container {
      margin: 20px 12px;
      padding: 30px 20px;
    }
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="policy-container">
  <div class="policy-header">
    <h1 class="policy-title">Contact Information</h1>
    <div class="policy-meta">Get in touch with us</div>
  </div>

  <div class="policy-notice">
    Have any questions, concerns, or need support? Our dedicated team is here to assist you.
  </div>

  <div class="contact-grid">
    <!-- Trade Name -->
    <div class="contact-card">
      <div class="contact-card-title">🌐 Trade Name</div>
      <div class="contact-card-value">zybuds.com</div>
      <div class="contact-card-sub">Official domain operated by Zybuds.</div>
    </div>

    <!-- Email Address -->
    <div class="contact-card">
      <div class="contact-card-title">✉️ Email Support</div>
      <div class="contact-card-value">
        <a href="mailto:Ganimedia1@gmail.com" style="color:var(--white); text-decoration:none;">Ganimedia1@gmail.com</a>
      </div>
      <div class="contact-card-sub">For general support, warranty claims, and order inquiries.</div>
    </div>

    <!-- WhatsApp Support -->
    <div class="contact-card">
      <div class="contact-card-title">💬 WhatsApp Support</div>
      <div class="contact-card-value">9704252065</div>
      <div class="contact-card-sub" style="color: var(--accent);">⚠️ Available only on WhatsApp. Note: strictly no voice/video calls.</div>
      <a href="https://wa.me/919704252065" target="_blank" class="wa-btn">
        💬 Chat on WhatsApp
      </a>
    </div>

    <!-- Physical Address -->
    <div class="contact-card" style="grid-column: span 1;">
      <div class="contact-card-title">📍 Physical Address</div>
      <div class="contact-card-value">
        Zybuds<br>
        Near Yellamma Temple, Nalgonda,<br>
        Telangana - 508001, India
      </div>
      <div class="contact-card-sub">Registered operational address.</div>
    </div>
  </div>
</div>
