    margin-bottom: 18px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .policy-content h3 {
    font-size: 15px;
    font-weight: 600;
    color: #ffb74d; /* Soft sunset orange */
    margin-top: 24px;
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  
  .policy-content p {
    font-size: 14.5px;
    color: var(--ink2);
    line-height: 1.8;
    margin-bottom: 16px;
  }
  
  .policy-content p:last-child {
    margin-bottom: 0;
  }
  
  .policy-content ul {
    margin-bottom: 20px;
    padding-left: 20px;
  }
  
  .policy-content li {
    font-size: 14px;
    color: var(--ink2);
    line-height: 1.7;
    margin-bottom: 8px;
    list-style-type: square;
  }
  
  .policy-contact-card {
    background: #07070d;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius);
    padding: 26px;
    margin-top: 30px;
    box-shadow: 0 6px 20px rgba(0,0,0,0.1);
  }
  
  .policy-contact-card p {
    margin-bottom: 14px !important;
  }
  
  .policy-contact-card p:last-child {
    margin-bottom: 0 !important;
  }
  
  .policy-contact-card strong {
    color: #ffffff;
  }
  
  @media (max-width: 768px) {
    .policy-container {
      margin: 20px 12px;
      padding: 35px 22px;
    }
    .policy-section-card {
      padding: 20px;
    }
  }
</style>

