<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <!-- URL Path & Shopify Variable Spoofing to enable Product-specific Apps (like EasySell & Shiprocket) on the Homepage -->
  <script>
    (function() {
      if (window.location.pathname === '/') {
        window.history.replaceState({}, '', '/products/earbuds-megasafe-power-bank');
        window.__spoofedPath = true;
        
        // Spoof all Shopify global variables to trick apps into thinking they are on a product page
        window.meta = window.meta || {};
        window.meta.page = window.meta.page || {};
        window.meta.page.pageType = 'product';
        
        window.ShopifyAnalytics = window.ShopifyAnalytics || {};
        window.ShopifyAnalytics.meta = window.ShopifyAnalytics.meta || {};
        window.ShopifyAnalytics.meta.page = window.ShopifyAnalytics.meta.page || {};
        window.ShopifyAnalytics.meta.page.pageType = 'product';
        
        window.Shopify = window.Shopify || {};
        window.Shopify.template = 'product';
        
        // Restore the URL to '/' after 3000ms so the user sees the homepage URL
        setTimeout(function() {
          if (window.location.pathname === '/products/earbuds-megasafe-power-bank') {
            window.history.replaceState({}, '', '/');
          }
        }, 3000);
      }
    })();
  </script>

  <!-- ============================================================
    Shiprocket Fetch Interceptor — MUST be first script on page.
    Shiprocket's uc.js reads the product handle from the page URL.
    On custom landing pages the URL has no product handle, so
    Shiprocket crashes with /products/null.json (404).
    This intercepts that bad fetch call and silently redirects it
    to the correct product URL so Shiprocket gets valid data.
  ============================================================ -->
  <script>
    (function() {
      var REAL_PRODUCT_HANDLE = 'earbuds-megasafe-power-bank';
      var _nativeFetch = window.fetch;
      window.fetch = function(resource, options) {
        var url = (typeof resource === 'string') ? resource : (resource && resource.url) || '';
        if (url.indexOf('/products/null') !== -1) {
          url = url.replace('/products/null', '/products/' + REAL_PRODUCT_HANDLE);
          resource = (typeof resource === 'string') ? url : new Request(url, resource);
        }
        return _nativeFetch.call(this, resource, options);
      };
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    {%- if template == 'product' -%}
      {{ product.title }} — {{ settings.shop_name_override | default: shop.name }} | {{ settings.city | default: 'Hyderabad' }}
    {%- elsif page_title -%}
      {{ page_title }} | {{ settings.shop_name_override | default: shop.name }}
    {%- else -%}
      {{ settings.shop_name_override | default: shop.name }} — Premium Wireless Earbuds | {{ settings.city | default: 'Hyderabad' }}
    {%- endif -%}
  </title>
  <meta name="description" content="{{ page_description | default: shop.description | escape }}">

  <!-- Canonical -->
  <link rel="canonical" href="{{ canonical_url }}">

  <!-- Shopify required -->
  {{ content_for_header }}

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <!-- Theme CSS -->
  {{ 'zybuds-base.css' | asset_url | stylesheet_tag }}
  {{ 'style.css' | asset_url | stylesheet_tag }}

  <!-- Razorpay SDK -->
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
</head>

<body>



  <!-- Header Section -->
  {% section 'header' %}

  <!-- Main content -->
  <main>
    {{ content_for_layout }}
  </main>

  <!-- Footer -->
  {% render 'footer' %}

  {%- unless template == 'cart' -%}
  <!-- Mobile sticky bar -->
  <div class="mob-bar" id="mobBar">
    {%- assign product_price = 140000 -%}
    {%- assign product_compare_at_price = 349900 -%}
    <div class="mob-price-wrap">
      <div class="mob-price-main" id="mobPriceMain">
        {%- if template == 'product' -%}
          {{ product_price | money }}
        {%- else -%}
          ₹1,400
        {%- endif -%}
      </div>
      <div class="mob-price-old">
        {%- if template == 'product' and product_compare_at_price > product_price -%}
          MRP {{ product_compare_at_price | money }}
        {%- else -%}
          MRP ₹3,499
        {%- endif -%}
      </div>
    </div>
    <button class="mob-order add-to-cart easysell-popup-button-overwrite" id="mobOrderBtn" onclick="handleOrder(event)">Pay ₹{{ settings.advance_amount | default: '99' }} → Confirm</button>
  </div>
  {%- endunless -%}



  <script>
    window.ZybudsSettings = {
      enableCustomCheckout: {{ settings.enable_custom_checkout | default: false | json }},
      advanceAmount: {{ settings.advance_amount | default: 99 }},
      warrantyYears: {{ settings.warranty_years | default: 1 }},
      city: {{ settings.city | default: 'Hyderabad' | json }},
      founderName: {{ settings.founder_name | default: 'Mahesh' | json }},
      ordersDelivered: {{ settings.orders_delivered | default: '500+' | json }},
      razorpayKey: {{ settings.razorpay_key_id | json }},
      orderApiUrl: {{ settings.order_api_url | default: 'https://zybuds-order-api.vercel.app/api/create-order' | json }},
      popupMessages: {{ settings.popup_messages | default: "Someone just bought AirPods Pro 2 in Hyderabad|Only 3 units left at this price!" | json }}
    };
  </script>

  <!-- Global Javascript -->
  {{ 'zybuds-main.js' | asset_url | append: '&v=1.1.0' | script_tag }}
</body>
</html>
