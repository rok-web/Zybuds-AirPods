<!-- ============================================================
   ZYBUDS — sections/product-page.liquid
   Complete product landing page section
   ============================================================ -->

{%- assign product_obj = section.settings.product | default: product | default: all_products.first | default: collections.all.products.first -%}

{%- if product_obj -%}
<script>
  // Fix for Shiprocket uc.js — it reads window.meta.product to get the product handle.
  // On custom landing pages, the URL has no product handle so it crashes with /products/null.json.
  // We manually inject the correct product data here so Shiprocket works correctly.
  window.meta = window.meta || {};
  window.meta.page = window.meta.page || {};
  window.meta.page.pageType = 'product';
  
  window.meta.product = {
    id: {{ product_obj.id | json }},
    handle: {{ product_obj.handle | json }},
    title: {{ product_obj.title | json }},
    vendor: {{ product_obj.vendor | json }},
    type: {{ product_obj.type | json }},
    variants: [
      {%- for variant in product_obj.variants -%}
      {
        id: {{ variant.id }},
        title: {{ variant.title | json }},
        price: {{ variant.price }},
        available: {{ variant.available }}
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  };
  // Also set ShopifyAnalytics meta for broader compatibility
  window.ShopifyAnalytics = window.ShopifyAnalytics || {};
  window.ShopifyAnalytics.meta = window.ShopifyAnalytics.meta || {};
  window.ShopifyAnalytics.meta.page = window.ShopifyAnalytics.meta.page || {};
  window.ShopifyAnalytics.meta.page.pageType = 'product';
  window.ShopifyAnalytics.meta.product = window.meta.product;
</script>
{%- endif -%}
{%- assign advance_raw = settings.advance_amount | default: 99 | plus: 0 -%}
{%- assign advance_cents = advance_raw | times: 100 -%}
{%- assign city = settings.city | default: 'Hyderabad' -%}
{%- assign warranty = settings.warranty_years | default: '1' -%}

{%- assign product_price = 140000 -%}
{%- assign product_compare_at_price = 349900 -%}
{%- assign remaining = product_price | minus: advance_cents -%}
{%- if product_obj and product_obj.id != blank -%}
  {%- assign has_product = true -%}
{%- else -%}
  {%- assign has_product = false -%}
{%- endif -%}

<!-- HERO GRID -->
<div class="hero">

  <!-- LEFT — IMAGE PANEL -->
  <div class="img-panel">
    <!-- Product image switcher snippet -->
    {%- assign custom_images = section.blocks | where: "type", "gallery_image" -%}
    {% render 'product-image-gallery', 
      product: product_obj, 
      custom_images: custom_images,
      gallery_img_1: section.settings.gallery_img_1,
      gallery_img_2: section.settings.gallery_img_2,
      gallery_img_3: section.settings.gallery_img_3,
      gallery_img_4: section.settings.gallery_img_4
    %}
  </div>

  <!-- RIGHT — INFO PANEL -->
  <div class="info-panel">
    <div class="editorial-label">Premium TWS · Hyderabad</div>

    <h1 class="p2-title">
      Zybuds AirPods Pro 2 with ANC + GPS Tracking and 13mm Drivers
    </h1>

    <p class="p2-tagline">
      {%- if product_obj -%}
        {{ product_obj.description | strip_html | truncatewords: 30 }}
      {%- else -%}
        We deliver across {{ city }} with open box COD. In the past, some customers placed fake orders for "timepass" — our delivery person would travel across the city, and the customer wouldn't answer the door. This wasted large amount of time and money.
      {%- endif -%}
    </p>

    <!-- Live Activity -->
    {% render 'live-activity' %}

    <!-- PAYMENT OPTION TOGGLE -->
    <div class="opt2-label">Payment Option: <span id="paymentOptionSelected">HALF PAYMENT</span></div>
    <div class="payment-options">
      <div class="pay-opt advance-opt active" onclick="selectPayOption('advance', this)">
        <div class="po-title">Pay ₹{{ advance_raw }} Advance</div>
        <div class="po-sub">Rest on Delivery</div>
      </div>
      <div class="pay-opt full-opt" onclick="selectPayOption('full', this)">
        <div class="po-title">Pay Full {%- if product_obj -%}{{ product_price | money }}{%- else -%}₹1,400{%- endif -%}</div>
        <div class="po-sub">Skip COD Process</div>
      </div>
    </div>

    <!-- PRICE BOX -->
    <div class="price-box2">
      <div class="price-box2-top">
        <div class="p2-main-price">
          {%- if product_obj -%}
            {{ product_price | money }}
          {%- else -%}
            <sup>₹</sup>1,400
          {%- endif -%}
        </div>
        {%- if product_obj and product_compare_at_price > product_price -%}
          <div class="p2-old-price">{{ product_compare_at_price | money }}</div>
          <div class="p2-save-chip">
            Save {{ product_compare_at_price | minus: product_price | money }}
          </div>
        {%- elsif product_obj == nil -%}
          <div class="p2-old-price">₹3,499</div>
          <div class="p2-save-chip">Save ₹2,099</div>
        {%- endif -%}
      </div>
      <div id="priceBreakdown" class="price-breakdown">
        Pay <strong>₹{{ advance_raw }} now</strong> to confirm →
        Remaining <strong>{{ remaining | money_without_trailing_zeros }} cash</strong> on delivery, after you check the product
      </div>
    </div>

    <!-- WHY ₹99 -->
    {% render 'why99-box' %}

    {%- comment -%} COLOR / VARIANT PICKER — Only show actual color options, skip payment variants {%- endcomment -%}
    {%- assign show_color_picker = false -%}
    {%- if product_obj and product_obj.variants.size > 1 -%}
      {%- for option in product_obj.options_with_values -%}
        {%- assign option_name_lower = option.name | downcase -%}
        {%- unless option_name_lower contains 'payment' -%}
          {%- assign show_color_picker = true -%}
          <div class="opt2-label">{{ option.name }}: <span id="col2Name">{{ option.selected_value | default: option.values.first }}</span></div>
          <div class="colors2">
            {%- for value in option.values -%}
              {%- assign color_class = value | downcase | replace: ' ', '' -%}
              <div class="col2 {{ color_class }}2 {% if forloop.first %}active{% endif %}"
                   title="{{ value }}"
                   onclick="pickCol2('{{ value }}', this)">
              </div>
            {%- endfor -%}
          </div>
        {%- endunless -%}
      {%- endfor -%}
    {%- endif -%}
    {%- unless show_color_picker -%}
      <div class="opt2-label">Color: <span id="col2Name">White</span></div>
      <div class="colors2">
        <div class="col2 white2 active" title="White" onclick="pickCol2('White', this)"></div>
      </div>
    {%- endunless -%}

    <!-- STOCK / URGENCY -->
    <div class="stock2">
      <div class="sdot"></div>
      <div>
        {%- if product_obj -%}
          {%- assign stock = product_obj.selected_or_first_available_variant.inventory_quantity -%}
          {%- if stock > 0 and stock <= 10 -%}
            <span class="stock2-text">Only {{ stock }} pieces left</span>
          {%- elsif stock <= 0 -%}
            <span class="stock2-text">Only 7 pieces left</span>
          {%- else -%}
            <span class="stock2-text">In Stock — Ready to Ship</span>
          {%- endif -%}
        {%- else -%}
          <span class="stock2-text">Only 7 pieces left</span>
        {%- endif -%}
        <span class="stock2-sub"> · <span id="dailyViewCount">122</span> people viewed this today</span>
      </div>
    </div>

    <!-- WARRANTY -->
    <div class="warranty-ribbon">
      <div class="wr-icon">🛡️</div>
      <div class="wr-text">
        <h4>{{ warranty }} Year Full Warranty — Included</h4>
        <p>Anything fails within {{ warranty | times: 12 }} months, we replace or fix it. No questions asked.</p>
      </div>
      <div class="wr-badge">{{ warranty }} Year<br>Warranty</div>
    </div>

    <!-- PRODUCT FORM -->
    <div class="product-form-container product-form">
      {%- if has_product -%}
        {%- form 'product', product_obj, id: 'ProductForm', class: 'product-form shopify-product-form', data-product-form: '', novalidate: 'novalidate' -%}
          {%- if settings.enable_custom_checkout -%}
            <input type="hidden" name="return_to" value="/cart?payment_success=true">
          {%- endif -%}
          <input type="hidden" name="id" value="51435208638759" id="productVariantIdInput">
          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="properties[Payment Type]" value="Advance" id="paymentTypeInput">
          <input type="hidden" name="properties[Shipping Name]" value="" id="hiddenShippingName">
          <input type="hidden" name="properties[Shipping Pincode]" value="" id="hiddenShippingPincode">
          <input type="hidden" name="properties[Shipping Address]" value="" id="hiddenShippingAddress">
          <input type="hidden" name="properties[Shipping Phone]" value="" id="hiddenShippingPhone">
          <input type="hidden" name="properties[Shipping City]" value="" id="hiddenShippingCity">
          <input type="hidden" name="properties[Shipping Landmark]" value="" id="hiddenShippingLandmark">
          <input type="hidden" name="properties[Shipping State]" value="" id="hiddenShippingState">
          
          <button type="submit" name="add" class="btn2-primary product-form__submit add-to-cart easysell-popup-button-overwrite" id="orderBtn" onclick="handleOrder(event)">
            <span>🛍️ BUY NOW — PAY ₹{{ advance_raw }}/-</span>
          </button>
          
          <!-- Render App Blocks (like EasySell) -->
          {%- for block in section.blocks -%}
            {%- render block -%}
          {%- endfor -%}
        {%- endform -%}
      {%- else -%}
        <div class="no-product-warning" style="margin-bottom:10px; color:var(--red); font-size:12px; font-weight:700;">Please select a product in Theme Editor</div>
        <button type="submit" {% if settings.enable_custom_checkout %}name="add"{% endif %} class="btn2-primary product-form__submit {% if settings.enable_custom_checkout %}add-to-cart{% endif %}{% unless settings.enable_custom_checkout %} es-popup-button-overwrite{% endunless %}" id="orderBtn" onclick="handleOrder(event)">
          <span>🛍️ BUY NOW — PAY ₹{{ advance_raw }}/-</span>
        </button>
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div class="product-app-block" style="margin-top:15px;" {{ block.shopify_attributes }}>
            {% render block %}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- GUARANTEE -->
    <div class="guarantee2">
      <div class="g2-title">🔒 Your Complete Protection</div>
      <div class="g2-grid">
        <div class="g2-item"><span class="g2-check">✅</span>
          <div><strong>Open Box Delivery</strong><br>Check before you pay</div>
        </div>
        <div class="g2-item"><span class="g2-check">✅</span>
          <div><strong>Same Day {{ city }}</strong><br>Order before 2 PM</div>
        </div>
        <div class="g2-item"><span class="g2-check">✅</span>
          <div><strong>₹{{ advance }} Refundable</strong><br>Not happy? Full refund</div>
        </div>
        <div class="g2-item"><span class="g2-check">✅</span>
          <div><strong>{{ warranty }} Year Warranty</strong><br>Full product coverage</div>
        </div>
      </div>
    </div>

    <!-- TRUST BADGES -->
    <div class="trust2-row">
      <div class="t2"><span class="ti">📦</span>
        <div class="tl">Open Box<br>Delivery</div>
      </div>
      <div class="t2"><span class="ti">🚀</span>
        <div class="tl">Same Day<br>{{ city }}</div>
      </div>
      <div class="t2"><span class="ti">🛡️</span>
        <div class="tl">{{ warranty }} Year<br>Warranty</div>
      </div>
      <div class="t2"><span class="ti">💰</span>
        <div class="tl">Cash on<br>Delivery</div>
      </div>
    </div>
  </div><!-- /info-panel -->
</div><!-- /hero -->


