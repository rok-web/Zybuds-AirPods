<script>
  (function() {
    function loadDriveVideos() {
      const players = document.querySelectorAll('.drive-video-player');
      players.forEach(p => {
        if (p.dataset.loaded) return;
        const id = p.dataset.id;
        
        // 1. Create native video element
        const video = document.createElement('video');
        video.autoplay = true;
        video.muted = true;
        video.loop = true;
        video.playsInline = true;
        video.style.width = '100%';
        video.style.height = '100%';
        video.style.objectFit = 'cover';
        video.style.display = 'block';

        const source = document.createElement('source');
        source.src = 'https://drive.google.com/uc?id=' + id + '&export=media';
        source.type = 'video/mp4';
        video.appendChild(source);

        p.appendChild(video);
        p.dataset.loaded = "true";

        // 2. Set a timeout: If it hasn't started playing in 3 seconds, switch to iframe
        let hasPlayed = false;
        video.onplaying = () => { hasPlayed = true; };
        
        setTimeout(() => {
          if (!hasPlayed) {
            console.log('Video ' + id + ' timed out, switching to iframe fallback.');
            p.innerHTML = '<iframe src="https://drive.google.com/file/d/' + id + '/preview?rm=minimal" width="100%" height="100%" style="border:none;position:absolute;top:0;left:0;" allow="autoplay" allowfullscreen="false"></iframe>';
          }
        }, 3500);

        // 3. Immediate error fallback
        video.onerror = () => {
          p.innerHTML = '<iframe src="https://drive.google.com/file/d/' + id + '/preview?rm=minimal" width="100%" height="100%" style="border:none;position:absolute;top:0;left:0;" allow="autoplay" allowfullscreen="false"></iframe>';
        };
      });
    }

    // Run loader
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadDriveVideos);
    } else {
      loadDriveVideos();
    }
    window.addEventListener('load', loadDriveVideos);

    // Global force play logic
    function forceAutoplay() {
      document.querySelectorAll('video').forEach(v => {
        // Exclude customer review videos so manual play/pause and unmute states are protected
        if (v.classList.contains('cv-video-el')) return;

        v.muted = true;
        v.setAttribute('muted', '');
        v.setAttribute('playsinline', '');
        if (v.paused) {
          v.play().catch(err => {
            // If blocked, we try again on next interval or interaction
          });
        }
      });
    }

    // Interactive Customer Reviews Video Controls
    window.togglePlay = function(container) {
      const video = container.querySelector('.cv-video-el');
      const playBtn = container.querySelector('.cv-play-btn');
      const volumeBtn = container.querySelector('.cv-volume-btn');
      if (!video || !playBtn) return;
      
      if (video.paused) {
        // Pause all other customer review videos on the page!
        document.querySelectorAll('.cv-video-el').forEach(otherVideo => {
          if (otherVideo !== video && !otherVideo.paused) {
            otherVideo.pause();
            const otherContainer = otherVideo.closest('.cv-item');
            if (otherContainer) {
              const otherPlayBtn = otherContainer.querySelector('.cv-play-btn');
              if (otherPlayBtn) {
                otherPlayBtn.classList.add('paused');
              }
            }
          }
        });

        // Automatically unmute when clicking play button!
        video.muted = false;
        if (volumeBtn) {
          const muteIcon = volumeBtn.querySelector('.mute-icon');
          const unmuteIcon = volumeBtn.querySelector('.unmute-icon');
          if (muteIcon && unmuteIcon) {
            muteIcon.style.display = 'none';
            unmuteIcon.style.display = 'block';
          }
          volumeBtn.classList.add('unmuted');
        }

        video.play().catch(err => {
          console.log('Video play failed:', err);
        });
        playBtn.classList.remove('paused');
      } else {
        video.pause();
        playBtn.classList.add('paused');
      }
    };

    window.toggleMute = function(event, btn) {
      event.stopPropagation(); // Avoid toggling play/pause on the container click
      const container = btn.closest('.cv-item');
      const video = container.querySelector('.cv-video-el');
      const muteIcon = btn.querySelector('.mute-icon');
      const unmuteIcon = btn.querySelector('.unmute-icon');
      if (!video) return;
      
      if (video.muted) {
        video.muted = false;
        muteIcon.style.display = 'none';
        unmuteIcon.style.display = 'block';
        btn.classList.add('unmuted');
      } else {
        video.muted = true;
        muteIcon.style.display = 'block';
        unmuteIcon.style.display = 'none';
        btn.classList.remove('unmuted');
      }
    };

    // Listen to video ended event to show play overlay button and reset timeline
    document.addEventListener("DOMContentLoaded", function() {
      document.querySelectorAll('.cv-video-el').forEach(video => {
        video.addEventListener('ended', function() {
          const container = this.closest('.cv-item');
          const playBtn = container.querySelector('.cv-play-btn');
          if (playBtn) {
            playBtn.classList.add('paused');
          }
          this.currentTime = 0; // Reset video to beginning
        });
      });
    });
    // Run every 2 seconds for the first 10 seconds, then every 5 seconds
    let fastInterval = setInterval(forceAutoplay, 2000);
    setTimeout(() => {
      clearInterval(fastInterval);
      setInterval(forceAutoplay, 5000);
    }, 10000);

    ['touchstart', 'click', 'scroll', 'mousedown'].forEach(e => {
      document.addEventListener(e, forceAutoplay, { once: true });
    });
  })();
</script>
