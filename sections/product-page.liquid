{%- if product_obj -%}
<script>
  window.ShopifyProduct = {
    id: {{ product_obj.id | json }},
    title: {{ product_obj.title | json }},
    price: 140000,
    compareAtPrice: 349900,
    variantId: {{ product_obj.selected_or_first_available_variant.id | json }},
    advanceAmount: {{ settings.advance_amount | default: 99 }},
    currency: {{ cart.currency.symbol | json }},
    available: {{ product_obj.selected_or_first_available_variant.available | default: false }}
  };

  // EasySell and other apps rely on window.meta.product when not on a standard /products/ url
  window.meta = window.meta || {};
  window.meta.product = {
    id: {{ product_obj.id | json }},
    handle: {{ product_obj.handle | json }},
    variants: [
      {%- for variant in product_obj.variants -%}
        {
          id: {{ variant.id | json }},
          price: {{ variant.price | json }},
          name: {{ variant.title | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  };
</script>
{%- endif -%}

