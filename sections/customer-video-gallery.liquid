{%- style -%}
  .cv-gallery-{{ section.id }} {
    padding: 60px 5%;
    background: #000;
  }

  .cv-gallery-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .cv-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .cv-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 900;
    color: #fff;
    margin-bottom: 12px;
  }

  .cv-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .cv-item {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: #111;
    aspect-ratio: 9 / 16; /* Portrait for customer reviews usually */
    border: 1px solid rgba(255,255,255,0.1);
  }

  .cv-item video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 991px) {
    .cv-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .cv-grid {
      gap: 12px;
    }
    .cv-item {
      border-radius: 12px;
    }
  }
{%- endstyle -%}

<section class="cv-gallery-{{ section.id }} reveal">
  <div class="cv-gallery-inner">
    <div class="cv-header">
      <h2 class="cv-title">{{ section.settings.heading | default: 'Our Customer Review' }}</h2>
    </div>

    <div class="cv-grid">
      {%- for i in (1..4) -%}
        {%- assign video_key = 'video_' | append: i -%}
        {%- assign video = section.settings[video_key] -%}
        
        <div class="cv-item" onclick="togglePlay(this)">
          {%- if video != blank -%}
            {{ video | video_tag: 
              autoplay: true, 
              loop: true, 
              muted: true, 
              playsinline: true, 
              controls: false,
              preload: "metadata",
              class: "cv-video-el"
            }}
            <!-- Play/Pause Centered Overlay Button -->
            <div class="cv-play-btn">
              <svg class="play-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </div>
            <!-- Volume Toggle Button (Stays visible in corner) -->
            <div class="cv-volume-btn" onclick="toggleMute(event, this)">
              <!-- Muted Icon (Default) -->
              <svg class="mute-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM12 4L9.91 6.09 12 8.18V4zm-8 4v8h4l5 5V3L8 8H4z"/></svg>
              <!-- Unmuted Icon -->
              <svg class="unmute-icon" viewBox="0 0 24 24" fill="currentColor" style="display:none;"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
            </div>
          {%- else -%}
            <div style="height:100%; display:flex; align-items:center; justify-content:center; color:#444; font-size:12px; text-align:center; padding:20px;">
              Video {{ i }} Placeholder
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (function() {
    if (!window.togglePlay) {
      window.togglePlay = function(container) {
        const video = container.querySelector('.cv-video-el');
        const playBtn = container.querySelector('.cv-play-btn');
        if (!video || !playBtn) return;
        
        if (video.paused) {
          video.play().catch(err => {
            console.log('Video play failed:', err);
          });
          playBtn.classList.remove('paused');
        } else {
          video.pause();
          playBtn.classList.add('paused');
        }
      };
    }

    if (!window.toggleMute) {
      window.toggleMute = function(event, btn) {
        event.stopPropagation(); // Avoid toggling play/pause on the container click
        const container = btn.closest('.cv-item');
        const video = container.querySelector('.cv-video-el');
        const muteIcon = btn.querySelector('.mute-icon');
        const unmuteIcon = btn.querySelector('.unmute-icon');
        if (!video) return;
        
        if (video.muted) {
          video.muted = false;
          muteIcon.style.display = 'none';
          unmuteIcon.style.display = 'block';
          btn.classList.add('unmuted');
        } else {
          video.muted = true;
          muteIcon.style.display = 'block';
          unmuteIcon.style.display = 'none';
          btn.classList.remove('unmuted');
        }
      };
    }
  })();
</script>

{% schema %}
{
  "name": "Customer Video Gallery",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Customer Review"
    },
    { "type": "video", "id": "video_1", "label": "Customer Video 1" },
    { "type": "video", "id": "video_2", "label": "Customer Video 2" },
    { "type": "video", "id": "video_3", "label": "Customer Video 3" },
    { "type": "video", "id": "video_4", "label": "Customer Video 4" }
  ],
  "presets": [
    {
      "name": "Customer Video Gallery"
    }
  ]
}
{% endschema %}
